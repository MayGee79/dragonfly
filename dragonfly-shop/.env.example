# Digital download links expire after this many days (default 30)
SHOP_DOWNLOAD_MAX_AGE_DAYS=30

# Rate limiting (optional but recommended in production)
# Vercel → shop project → Storage / Marketplace → Upstash Redis → connect to project
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=https://dragonflyshop.co.uk
NEXT_PUBLIC_MAIN_SITE_URL=https://www.dragonflypsychotherapy.co.uk

# Stripe (live keys on Vercel production)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs (live) — RSD launch set
STRIPE_PRICE_RSD_HANDBOOK_EBOOK=price_...
STRIPE_PRICE_RSD_HANDBOOK_PAPERBACK=price_...
STRIPE_PRICE_RSD_WORKBOOK_EBOOK=price_...
STRIPE_PRICE_RSD_WORKBOOK_PAPERBACK=price_...
# Starting University Student Guide (auto go-live 2026-07-27 London)
STRIPE_PRICE_UNIVERSITY_STUDENT_GUIDE=price_1TvgpoL5oOakupFeE8RVAKvX
STRIPE_PRICE_UNIVERSITY_STUDENT_GUIDE_PAPERBACK=price_1Tvg2yL5oOakupFerp1bUPjs

# Google Analytics (same property as main site, or set a shop-specific ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-39GL2MNTGV

# Meta (Facebook) Pixel — loaded only after cookie consent
NEXT_PUBLIC_META_PIXEL_ID=1567033625209529

# MailerLite (optional newsletter opt-in at checkout — single opt-in)
MAILERLITE_API_KEY=
# Optional: MailerLite group ID for shop subscribers (from MailerLite → Groups)
MAILERLITE_GROUP_ID=

# Resend (optional — sends welcome email after newsletter signup; same key as main site)
RESEND_API_KEY=
NEWSLETTER_WELCOME_FROM=Dragonfly Psychotherapy <victoria@dragonflypsychotherapy.co.uk>

# Stripe webhook (live mode endpoint: /api/webhooks/stripe — event checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob (private PDFs for digital products — optional; falls back to private/downloads/ locally)
# Link a Blob store in the Vercel project; Vercel usually injects BLOB_READ_WRITE_TOKEN automatically.
# For local dev, run: vercel env pull  — or paste the token from Vercel → Storage → your store.
BLOB_READ_WRITE_TOKEN=
# Canonical blob URLs (no ?query) from dashboard after upload — one per download catalogue id
BLOB_DOWNLOAD_URL_RSD_HANDBOOK_EBOOK=https://YOUR_STORE.private.blob.vercel-storage.com/RSD%20Handbook.pdf
BLOB_DOWNLOAD_URL_RSD_WORKBOOK_EBOOK=https://YOUR_STORE.private.blob.vercel-storage.com/RSD%20Workbook.pdf
# Student Guide digital formats (set when going live)
# BLOB_DOWNLOAD_URL_UNIVERSITY_STUDENT_GUIDE=https://YOUR_STORE.private.blob.vercel-storage.com/university-student-guide-2026.pdf
# BLOB_DOWNLOAD_URL_UNIVERSITY_STUDENT_GUIDE_EPUB=https://YOUR_STORE.private.blob.vercel-storage.com/university-student-guide-2026.epub
