# Production / Vercel: set these when going live
# NEXT_PUBLIC_SITE_URL=https://dragonflypsychotherapy.co.uk

# Contact form (Resend) – required for /api/contact
# Get API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Without domain verification, Resend only allows sending TO your Resend account email. For local testing set:
# CONTACT_EMAIL_OVERRIDE_TO=your-resend-account@gmail.com
# Optional: where enquiries are sent (default: victoria@dragonflypsychotherapy.co.uk)
# CONTACT_EMAIL_TO=victoria@dragonflypsychotherapy.co.uk
# Optional: from address. Use onboarding@resend.dev until domain verified; then e.g. contact@dragonflypsychotherapy.co.uk
# CONTACT_EMAIL_FROM=Dragonfly Psychotherapy <contact@dragonflypsychotherapy.co.uk>

# If reverting to Formspree, set these and switch Contact.tsx back to Formspree endpoint
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/xaqqqyoa
# NEXT_PUBLIC_FORMSPREE_KEY=
